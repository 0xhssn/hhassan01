# ============================================================
#  Environment Variables — copy to .env and fill in values
#  cp .env.example .env
#
#  ⚠  Never commit .env — it is already in .gitignore
# ============================================================

# ---- General --------------------------------------------
NODE_ENV=development
RAILS_ENV=development
PYTHONUNBUFFERED=1

# ---- Database (PostgreSQL) -------------------------------
# Docker Compose default credentials (safe for local dev only)
POSTGRES_USER=devuser
POSTGRES_PASSWORD=devpass
POSTGRES_DB=devdb
POSTGRES_HOST=postgres          # use "localhost" outside Docker
POSTGRES_PORT=5432

DATABASE_URL=postgres://devuser:devpass@postgres:5432/devdb

# ---- Redis -----------------------------------------------
REDIS_HOST=redis                # use "localhost" outside Docker
REDIS_PORT=6379
REDIS_URL=redis://redis:6379

# ---- Node.js / NestJS ------------------------------------
PORT=3000
# JWT_SECRET=change_me_in_production
# API_KEY=

# ---- Ruby / Rails ----------------------------------------
# SECRET_KEY_BASE=              # generate with: rails secret
BUNDLE_PATH=/bundle

# ---- Python ----------------------------------------------
# OPENAI_API_KEY=

# ---- Go / Gin --------------------------------------------
GIN_MODE=debug
# GIN_PORT=8080

# ---- AWS (optional) -------------------------------------
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_DEFAULT_REGION=us-east-1
# AWS_S3_BUCKET=

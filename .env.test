# ============================================================
# Test Environment Configuration
# ============================================================
# Copy this file to .env.test.local to override locally.
# These values match the Docker Compose test services.
# ============================================================

NODE_ENV=test

# ── PostgreSQL ──────────────────────────────────────────────
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_USER=testuser
POSTGRES_PASSWORD=testpassword
POSTGRES_DB=testdb
POSTGRES_TEST_URL=postgresql://testuser:testpassword@localhost:5433/testdb

# ── MySQL ───────────────────────────────────────────────────
MYSQL_HOST=localhost
MYSQL_PORT=3307
MYSQL_USER=testuser
MYSQL_PASSWORD=testpassword
MYSQL_ROOT_PASSWORD=rootpassword
MYSQL_DB=testdb
MYSQL_TEST_URL=mysql://testuser:testpassword@localhost:3307/testdb

# ── MongoDB ─────────────────────────────────────────────────
MONGO_HOST=localhost
MONGO_PORT=27018
MONGO_USER=testuser
MONGO_PASSWORD=testpassword
MONGO_DB=testdb
MONGO_TEST_URL=mongodb://testuser:testpassword@localhost:27018/testdb?authSource=admin

# ── Docker control ──────────────────────────────────────────
# Set to "true" to auto-start Docker containers during global setup
DB_AUTO_START=true
# Milliseconds to wait for containers to be healthy
DB_STARTUP_TIMEOUT=30000
# Set to "true" to tear down containers after the full test run
DB_AUTO_TEARDOWN=false

# ── Test isolation ──────────────────────────────────────────
# Strategy: "transaction" | "truncate" | "drop-recreate"
DB_ISOLATION_STRATEGY=transaction
